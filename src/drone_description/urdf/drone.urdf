<?xml version="1.0"?>
<robot name="drone">

  <!-- ========== 机身 base_link（根连杆） ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <!-- ========== 四个机臂 ========== -->
  <!-- 左前机臂 -->
  <joint name="joint_arm_fl" type="fixed">
    <parent link="base_link"/>
    <child link="arm_front_left"/>
    <origin xyz="0.12 0.12 0" rpy="0 0 0"/>
  </joint>
  <link name="arm_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.03 0.02"/>
      </geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.25 0.03 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- 右前机臂 -->
  <joint name="joint_arm_fr" type="fixed">
    <parent link="base_link"/>
    <child link="arm_front_right"/>
    <origin xyz="0.12 -0.12 0" rpy="0 0 0"/>
  </joint>
  <link name="arm_front_right">
    <visual>
      <geometry><box size="0.25 0.03 0.02"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.25 0.03 0.02"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <!-- 左后机臂 -->
  <joint name="joint_arm_rl" type="fixed">
    <parent link="base_link"/>
    <child link="arm_rear_left"/>
    <origin xyz="-0.12 0.12 0" rpy="0 0 0"/>
  </joint>
  <link name="arm_rear_left">
    <visual>
      <geometry><box size="0.25 0.03 0.02"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.25 0.03 0.02"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <!-- 右后机臂 -->
  <joint name="joint_arm_rr" type="fixed">
    <parent link="base_link"/>
    <child link="arm_rear_right"/>
    <origin xyz="-0.12 -0.12 0" rpy="0 0 0"/>
  </joint>
  <link name="arm_rear_right">
    <visual>
      <geometry><box size="0.25 0.03 0.02"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.25 0.03 0.02"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <!-- ========== 四个电机（在机臂末端） ========== -->
  <joint name="joint_motor_fl" type="fixed">
    <parent link="arm_front_left"/>
    <child link="motor_fl"/>
    <origin xyz="0.125 0 0.01" rpy="0 0 0"/>
  </joint>
  <link name="motor_fl">
    <visual>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.03" length="0.02"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="joint_motor_fr" type="fixed">
    <parent link="arm_front_right"/>
    <child link="motor_fr"/>
    <origin xyz="0.125 0 0.01" rpy="0 0 0"/>
  </joint>
  <link name="motor_fr">
    <visual>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.03" length="0.02"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="joint_motor_rl" type="fixed">
    <parent link="arm_rear_left"/>
    <child link="motor_rl"/>
    <origin xyz="-0.125 0 0.01" rpy="0 0 0"/>
  </joint>
  <link name="motor_rl">
    <visual>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.03" length="0.02"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="joint_motor_rr" type="fixed">
    <parent link="arm_rear_right"/>
    <child link="motor_rr"/>
    <origin xyz="-0.125 0 0.01" rpy="0 0 0"/>
  </joint>
  <link name="motor_rr">
    <visual>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.03" length="0.02"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <!-- ========== 前视摄像头 ========== -->
  <joint name="joint_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.15 0 -0.02" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.04 0.02"/></geometry>
      <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.03 0.04 0.02"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>

  <!-- p3d插件：发布无人机真实位置和速度（模拟GPS+IMU） -->
  <gazebo>
    <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/</namespace>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <body_name>drone::base_link</body_name>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>


  <!-- ========== Gazebo 颜色（不加的话模型在Gazebo里是白色） ========== -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- 施力插件（模型级插件，用不带 reference 的 gazebo 块） -->
  <gazebo>
    <plugin name="drone_force" filename="libgazebo_ros_force.so">
      <ros>
        <namespace>/drone</namespace>
        <remapping>gazebo_ros_force:=force</remapping>
      </ros>
      <link_name>base_link</link_name>
      <force_frame>world</force_frame>
    </plugin>
  </gazebo>
  <gazebo reference="arm_front_left">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="arm_front_right">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="arm_rear_left">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="arm_rear_right">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="motor_fl">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="motor_fr">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="motor_rl">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="motor_rr">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="camera_link">
    <material>Gazebo/Red</material>
  </gazebo>

</robot>
